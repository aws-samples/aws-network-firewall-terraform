# Example Terraform variables file
# Copy this file to terraform.tfvars and modify as needed

# Project configuration
project_name = "nfw-multi-endpoint-demo"

# Network configuration
vpc_cidr = "10.2.0.0/16"

# Infrastructure configuration
availability_zone = "eu-central-1a"  # Change to your preferred AZ (must include zone letter)
instance_type     = "t3.micro"       # Change to your preferred instance type